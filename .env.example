# Copy to .env and fill in. Never commit .env.

# Jev is reached through OpenRouter (Decisions endpoint).
# This is the only credential the tool needs: Zotero is read through the
# desktop local API, which requires no key.
OPENROUTER_API_KEY=

# Zotero local API write key. Granted once through Zotero's confirmation
# dialog (choose "Always Allow"); jevero writes it here automatically so later
# runs need no dialog. This key can write your whole library: to revoke it,
# delete the line below and use Zotero -> Settings -> Advanced ->
# "Clear Write Authorizations".
ZOTERO_LOCAL_WRITE_KEY=

# The zotero.org Web API is not used at the moment; its client is archived in
# archive/zotero_web_api.py. Restoring it would need these again:
# ZOTERO_API_KEY=
# ZOTERO_LIBRARY_ID=
