# Copy to .env and fill in. Never commit .env.
#
# Jev is reached through OpenRouter (Decisions endpoint).
OPENROUTER_API_KEY=

# Zotero Web API. Requires a key with library read + write access.
# Only needed when zotero.backend is "web" in config.yaml.
ZOTERO_API_KEY=

# Personal library ID (the number in zotero.org/my/library), or the group ID
# when zotero.library_type is "group" in config.yaml.
ZOTERO_LIBRARY_ID=
